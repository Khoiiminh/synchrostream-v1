# Prevents large video binaries from bloating your repo
/uploads
/movies
*.mp4
*.mkv
*.m3u8
**/uploads/**/*.ts
*.mpd

# --- IDE & System ---
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log

